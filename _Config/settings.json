{
  "Tasks": {
    "CompletedTaskRetention": 30,
    "ShowCompletedTasks": true,
    "DefaultPriority": "Medium"
  },
  "Templates": {
    "Macros": {
      "Items": [
        {
          "Actions": [
            {
              "Fields": [
                "Amount",
                "Category"
              ],
              "Type": "Summarization"
            },
            {
              "FileName": "analysis_results.xlsx",
              "Type": "ExportToExcel"
            }
          ],
          "Name": "Basic Analysis",
          "Description": "Standard analysis workflow"
        }
      ],
      "Enabled": true
    },
    "Commands": {
      "Items": [
        {
          "Template": "IDEA@EXPORT DATABASE {DATABASE} TO {OUTPUT_FILE}.CSV",
          "Name": "Export to CSV",
          "Placeholders": [
            "DATABASE",
            "OUTPUT_FILE"
          ],
          "Description": "Export current database to CSV format"
        },
        {
          "Template": "IDEA@JOIN DATABASE {PRIMARY} WITH {SECONDARY} ON {KEY_FIELD}",
          "Name": "Join Databases",
          "Placeholders": [
            "PRIMARY",
            "SECONDARY",
            "KEY_FIELD"
          ],
          "Description": "Join two databases on a common field"
        }
      ],
      "Enabled": true
    },
    "TimeEntry": {
      "Items": [
        {
          "DefaultHours": 0.25,
          "Name": "Daily Standup",
          "DefaultDays": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday"
          ],
          "Description": "Daily standup meeting",
          "ProjectID": "Internal"
        },
        {
          "DefaultHours": 1.0,
          "Name": "Weekly Planning",
          "DefaultDays": [
            "Monday"
          ],
          "Description": "Weekly planning and review",
          "ProjectID": "Internal"
        }
      ],
      "Enabled": true
    }
  },
  "Theme": {
    "AvailableThemes": [
      "amber",
      "amber-black",
      "default",
      "matrix",
      "matrix-rain",
      "synthwave-84",
      "synthwave-outrun"
    ],
    "CurrentTheme": "amber",
    "EnableLiveEdit": true,
    "UserCustomizations": {},
    "EditTheme": "[Click to open theme editor]",
    "ShowThemePreview": true
  },
  "Logging": {
    "Level": "Debug",
    "MaxFileSize": 10,
    "MaxFiles": 5
  },
  "Performance": {
    "EnableCaching": true,
    "MaxCacheSize": 100,
    "RenderOptimization": true
  },
  "FileBrowser": {
    "ShowFileSize": true,
    "ShowHiddenFiles": true,
    "ShowModifiedDate": false,
    "IgnoredExtensions": [
      ".tmp",
      ".cache",
      ".log"
    ],
    "DefaultPath": "/home/teej/projects/github/praxis",
    "SortDescending": false,
    "SortBy": "Name"
  },
  "UI": {
    "UseGradients": false,
    "VerticalSpacing": 1,
    "CompactMode": false,
    "GradientType": "vertical",
    "ShowScrollbars": true,
    "AnimationsEnabled": true
  },
  "Projects": {
    "BackupCount": 5,
    "DefaultPath": "/home/teej/projects/github/praxis/_ProjectData",
    "AutoSave": true,
    "BackupEnabled": true
  },
  "Editor": {
    "HighlightCurrentLine": true,
    "WordWrap": false,
    "AutoSaveInterval": 0,
    "ShowLineNumbers": true,
    "TabSize": 4,
    "SyntaxHighlighting": true
  }
}
