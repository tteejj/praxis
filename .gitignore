# PRAXIS - Ignore temporary and generated files

# Auto-save files
_AutoSave/
*.auto

# Log files  
_Logs/*.log
_Logs/*.log.old

# Temporary files
*.tmp
*.temp
*_temp_*

# Backup files (optional - may want to keep some)
# _Backup/

# User-specific configuration overrides
_Config/user.json

# Editor temporary files
*.swp
*.swo
*~

# OS generated files  
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.code-workspace

# Claude Flow generated files
.claude/settings.local.json
.mcp.json
claude-flow.config.json
.swarm/
.hive-mind/
memory/claude-flow-data.json
memory/sessions/*
!memory/sessions/README.md
memory/agents/*
!memory/agents/README.md
coordination/memory_bank/*
coordination/subtasks/*
coordination/orchestration/*
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-wal
claude-flow
claude-flow.bat
claude-flow.ps1
hive-mind-prompt-*.txt
