<Window x:Class="PraxisWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:taskViewer="clr-namespace:PraxisWpf.Features.TaskViewer"
        Title="Praxis WPF Task Manager" Height="600" Width="800">
    
    <Window.InputBindings>
        <KeyBinding Key="N" Command="{Binding NewCommand}"/>
        <KeyBinding Key="E" Command="{Binding EditCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="OemPlus" Command="{Binding ExpandCommand}"/>
        <KeyBinding Key="Add" Command="{Binding ExpandCommand}"/>
        <KeyBinding Key="OemMinus" Command="{Binding CollapseCommand}"/>
        <KeyBinding Key="Subtract" Command="{Binding CollapseCommand}"/>
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding ExpandAllCommand}"/>
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding ExpandAllCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding CollapseAllCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding CollapseAllCommand}"/>
    </Window.InputBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CyberControlBrush}" 
                BorderBrush="{StaticResource CyberBorderBrush}" 
                BorderThickness="0,0,0,2" Padding="10">
            <TextBlock Text="PRAXIS TASK MANAGER" 
                       FontSize="16" FontWeight="Bold" TextAlignment="Center"/>
        </Border>

        <!-- Main content -->
        <taskViewer:TaskView Grid.Row="1" DataContext="{Binding}"/>

        <!-- Status bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="N: New | E: Edit | Del: Delete | +/-: Expand/Collapse | Ctrl+S: Save"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>