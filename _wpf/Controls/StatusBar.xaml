<UserControl x:Class="PraxisWpf.Controls.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:PraxisWpf.Services">
    
    <UserControl.Resources>
        <!-- Status Type to Color Converter -->
        <services:StatusTypeToColorConverter x:Key="StatusColorConverter"/>
        
        <!-- Status Icon Converter -->
        <services:StatusTypeToIconConverter x:Key="StatusIconConverter"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource CyberControlBrush}" 
            BorderBrush="{DynamicResource CyberBorderBrush}" 
            BorderThickness="0,1,0,0"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
        
        <Grid Height="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Icon -->
            <TextBlock Grid.Column="0" 
                       Text="{Binding CurrentMessage.Type, Converter={StaticResource StatusIconConverter}}"
                       Foreground="{Binding CurrentMessage.Type, Converter={StaticResource StatusColorConverter}}"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="14"
                       Margin="8,0,4,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding CurrentMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Status Message -->
            <TextBlock Grid.Column="1" 
                       Text="{Binding CurrentMessage.Message}"
                       Foreground="{Binding CurrentMessage.Type, Converter={StaticResource StatusColorConverter}}"
                       VerticalAlignment="Center"
                       Margin="4,0"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding CurrentMessage.Message}"/>

            <!-- Progress Bar -->
            <ProgressBar Grid.Column="1"
                         Value="{Binding CurrentMessage.Progress}"
                         Minimum="0"
                         Maximum="100"
                         Height="4"
                         Margin="4,0"
                         VerticalAlignment="Bottom"
                         Visibility="{Binding CurrentMessage.ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}"
                         Foreground="{DynamicResource CyberAccentBrush}"
                         Background="{DynamicResource CyberPanelBrush}"/>

            <!-- Message Count -->
            <TextBlock Grid.Column="2"
                       Text="{Binding Messages.Count, StringFormat='{}{0} messages'}"
                       Foreground="{DynamicResource CyberDimCyanBrush}"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Margin="4,0,8,0"
                       Visibility="{Binding Messages.Count, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Timestamp -->
            <TextBlock Grid.Column="3"
                       Text="{Binding CurrentMessage.Timestamp, StringFormat='HH:mm:ss'}"
                       Foreground="{DynamicResource CyberDimCyanBrush}"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Visibility="{Binding CurrentMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Border>
</UserControl>