{
  "info": "Default key mappings for SimpleTaskPro. Copy entries to keymappings.json to customize.",
  "mappings": {
    "Enter": {
      "command": "action.select",
      "description": "Select/activate item"
    },
    "Esc": {
      "command": "action.cancel",
      "description": "Cancel/escape"
    },
    "Ctrl+c": {
      "command": "edit.copy",
      "description": "Copy selection"
    },
    "Backspace": {
      "command": "edit.backspace",
      "description": "Delete character backward"
    },
    "F5": {
      "command": "action.refresh",
      "description": "Refresh data"
    },
    "Right": {
      "command": "nav.right",
      "description": "Move selection right"
    },
    "F3": {
      "command": "screen.time",
      "description": "Switch to Time Entry screen"
    },
    "PageDown": {
      "command": "nav.page_down",
      "description": "Page down"
    },
    "PageUp": {
      "command": "nav.page_up",
      "description": "Page up"
    },
    "n": {
      "command": "action.new",
      "description": "Create new item"
    },
    "F7": {
      "command": "screen.tasks",
      "description": "Switch to Tasks screen"
    },
    "Ctrl+x": {
      "command": "edit.cut",
      "description": "Cut selection"
    },
    "Up": {
      "command": "nav.up",
      "description": "Move selection up"
    },
    "Down": {
      "command": "nav.down",
      "description": "Move selection down"
    },
    "Ctrl+s": {
      "command": "action.save",
      "description": "Save changes"
    },
    "Delete": {
      "command": "action.delete",
      "description": "Delete item"
    },
    "End": {
      "command": "nav.end",
      "description": "Go to end"
    },
    "F1": {
      "command": "app.help",
      "description": "Show help"
    },
    "r": {
      "command": "action.refresh",
      "description": "Refresh data"
    },
    "d": {
      "command": "action.delete",
      "description": "Delete item"
    },
    "F4": {
      "command": "screen.commands",
      "description": "Switch to Commands screen"
    },
    "Left": {
      "command": "nav.left",
      "description": "Move selection left"
    },
    "F6": {
      "command": "screen.excel",
      "description": "Switch to Excel Mapping screen"
    },
    "t": {
      "command": "app.theme.cycle",
      "description": null
    },
    "F2": {
      "command": "action.edit",
      "description": "Edit item"
    },
    "Spacebar": {
      "command": "task.toggle.collapse",
      "description": null
    },
    "s": {
      "command": "action.save",
      "description": "Save changes"
    },
    "Ctrl+q": {
      "command": "app.exit",
      "description": "Exit application"
    },
    "x": {
      "command": "task.toggle.complete",
      "description": null
    },
    "Ctrl+v": {
      "command": "edit.paste",
      "description": "Paste from clipboard"
    },
    "e": {
      "command": "action.edit",
      "description": "Edit item"
    },
    "Ctrl+n": {
      "command": "action.new",
      "description": "Create new item"
    },
    "Home": {
      "command": "nav.home",
      "description": "Go to beginning"
    }
  }
}